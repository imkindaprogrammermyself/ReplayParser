@echo off
rem Generated by tools/update.py full. Pulls everything the viewer uses for every ship and map (needs ~10 GB free).
rem Usage: put this file and wowsunpack.exe (from ModSDK) in one folder, then
rem        game_full.bat "C:\Games\World_of_Warships"
rem Reads from the game only. Writes .\wows_full and zips it to .\wows_full.zip.
setlocal
if "%~1"=="" (
    echo usage: %~nx0 "path\to\World_of_Warships"
    exit /b 1
)
set "GAME=%~1"
set "HERE=%~dp0"
set "UNPACK=%HERE%wowsunpack.exe"
set "OUT=%HERE%wows_full"
if not exist "%UNPACK%" (
    echo wowsunpack.exe not found next to this script
    exit /b 1
)
set "BUILD="
for /f "delims=" %%d in ('dir /b /ad /o-n "%GAME%\bin"') do (
    if not defined BUILD if exist "%GAME%\bin\%%d\idx" set "BUILD=%%d"
)
if not defined BUILD (
    echo no bin\^<build^>\idx folder found in "%GAME%"
    exit /b 1
)
set "IDX=%GAME%\bin\%BUILD%\idx"
set "PKG=..\..\..\res_packages"
rem clear only a previous run of this script (it leaves update_manifest.txt)
if exist "%OUT%\update_manifest.txt" rmdir /s /q "%OUT%"
if not exist "%OUT%" mkdir "%OUT%"
set "LOG=%OUT%\extract_log.txt"
echo build %BUILD% > "%OUT%\update_manifest.txt"
echo build %BUILD% > "%LOG%"
if exist "%GAME%\game_info.xml" copy /y "%GAME%\game_info.xml" "%OUT%\game_info.xml" > nul
echo build %BUILD%

echo game data...
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "scripts/*" >> "%LOG%" 2>&1
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "content/GameParams.data" >> "%LOG%" 2>&1
echo maps...
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "spaces/*/terrain.bin" >> "%LOG%" 2>&1
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "spaces/*/space.settings" >> "%LOG%" 2>&1
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "spaces/*/minimap.png" >> "%LOG%" 2>&1
echo ship models...
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "content/assets.bin" >> "%LOG%" 2>&1
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "content/gameplay/*/ship/*.geometry" >> "%LOG%" 2>&1
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "content/gameplay/*/gun/*.geometry" >> "%LOG%" 2>&1
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "content/gameplay/*/director/*.geometry" >> "%LOG%" 2>&1
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "content/gameplay/*/finder/*.geometry" >> "%LOG%" 2>&1
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "content/gameplay/*/radar/*.geometry" >> "%LOG%" 2>&1
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "content/gameplay/*/catapult/*.geometry" >> "%LOG%" 2>&1
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "content/gameplay/*/misc/*.geometry" >> "%LOG%" 2>&1
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "content/gameplay/*/cap/*.geometry" >> "%LOG%" 2>&1
echo gui icons...
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "gui/ship_icons/*" >> "%LOG%" 2>&1
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "gui/ship_dead_icons/*" >> "%LOG%" 2>&1
"%UNPACK%" -x "%IDX%" -p "%PKG%" -o "%OUT%" -I "gui/*minimap*" >> "%LOG%" 2>&1
"%UNPACK%" -l -x "%IDX%" -p "%PKG%" -I "gui/*" > "%OUT%\gui_files.txt" 2>> "%LOG%"

echo zipping (a big pull takes a while)...
if exist "%HERE%wows_full.zip" del "%HERE%wows_full.zip"
rem Windows' own tar (Windows 10 1803+, bsdtar) writes zip64 quickly - called by full path, as a GNU tar earlier
rem on PATH (Git's) can't write zips. Compress-Archive is the slow fallback.
set "TAR=%SystemRoot%\System32\tar.exe"
if not exist "%TAR%" goto ps_zip
pushd "%OUT%"
set "ITEMS="
for /f "delims=" %%e in ('dir /b') do call set ITEMS=%%ITEMS%% "%%e"
"%TAR%" -a -c -f "%HERE%wows_full.zip" %ITEMS%
set "ZIPERR=%errorlevel%"
popd
if "%ZIPERR%"=="0" goto zipped
:ps_zip
powershell -NoProfile -Command "Compress-Archive -Path '%OUT%\*' -DestinationPath '%HERE%wows_full.zip'"
:zipped
echo done: %HERE%wows_full.zip
endlocal
